# ── Secrets ──────────────────────────────────────────────────────────────
.env

# ── Data artifacts (large binaries and generated files; not versioned) ───
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/features/*
!data/features/.gitkeep
data/kg/*
!data/kg/.gitkeep
data/series/*
!data/series/.gitkeep
data/forecast/*
!data/forecast/.gitkeep
data/generated/*
!data/generated/.gitkeep

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pkl
*.pt
*.pth
.venv/
venv/
*.egg-info/
build/
dist/

# ── Node ──────────────────────────────────────────────────────────────────
node_modules/
package-lock.json

# ── Tooling / IDE ─────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.vscode/
.idea/

# ── OS ────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
